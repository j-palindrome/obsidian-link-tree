{
  "name": "obsidian-link-tree",
  "version": "1.0.0",
  "description": "View file links and backlinks as a recursively expandable, filterable list",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:vault": "VAULT=\"$(cd ../../.. && pwd)\" node esbuild.config.mjs",
    "build": "MODE=production VAULT=\"$(cd ../../.. && pwd)\" node esbuild.config.mjs",
    "check": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [],
  "author": "Joshua Reinier",
  "license": "ISC",
  "dependencies": {
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "obsidian": "^1.4.11",
    "obsidian-dataview": "^0.5.61",
    "react": "^18.2.0",
    "react-contenteditable": "^3.3.7",
    "react-dom": "^18.2.0",
    "react-transition-group": "^4.4.5",
    "react-usestateref": "^1.0.8",
    "tiny-invariant": "^1.3.1",
    "zustand": "^4.4.6",
    "immer": "^10.0.3"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.27",
    "@types/lodash": "^4.14.201",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.17",
    "@types/react-transition-group": "^4.4.11",
    "autoprefixer": "^10.4.16",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.5",
    "esbuild-copy-static-files": "^0.1.0",
    "esbuild-postcss": "^0.0.4",
    "postcss": "^8.4.23",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.6.3"
  }
}
